from flask import Flask, jsonify, request
import pymysql

app = Flask(__name__)

def get_db():
    return pymysql.connect(host="10.3.1.5", user="appuser", password="aya@2026",
                           database="gestion_produits", autocommit=True,
                           cursorclass=pymysql.cursors.DictCursor)
@app.route("/api/produits", methods=["GET"])
def lister():
    with get_db() as db, db.cursor() as cur:
        cur.execute("SELECT * FROM produits ORDER BY id")
        return jsonify(cur.fetchall())

@app.route("/api/produits", methods=["POST"])
def ajouter():
    d = request.get_json()
    with get_db() as db, db.cursor() as cur:
        cur.execute("INSERT INTO produits (nom, description, prix, categorie) VALUES (%s,%s,%s,%s)",
                    (d["nom"], d.get("description"), d["prix"], d.get("categorie")))
        return jsonify({"id": cur.lastrowid}), 201

@app.route("/api/produits/<int:id>", methods=["PUT"])
def modifier(id):
    d = request.get_json()
    with get_db() as db, db.cursor() as cur:
        cur.execute("UPDATE produits SET nom=%s, description=%s, prix=%s, categorie=%s WHERE id=%s",
                    (d["nom"], d.get("description"), d["prix"], d.get("categorie"), id))
        return jsonify({"message": "modifié"})

@app.route("/api/produits/<int:id>", methods=["DELETE"])
def supprimer(id):
    with get_db() as db, db.cursor() as cur:
        cur.execute("DELETE FROM produits WHERE id=%s", (id,))
        return jsonify({"message": "supprimé"})
